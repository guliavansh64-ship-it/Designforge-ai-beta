rules_version = '2';

// DesignForge AI — Firestore security rules
//
// Architecture: the web and Android clients NEVER talk to Firestore directly. Firebase is used
// on the client only for Authentication. Every read/write goes through the Express API, which
// uses the Firebase Admin SDK (Admin SDK bypasses these rules) and enforces ownership, plan
// entitlements, credits, idempotency and admin RBAC server-side.
//
// Therefore the correct client posture is DENY ALL. This prevents, for example:
//   - a user granting themselves credits (credit_wallets / credit_transactions)
//   - a user activating a plan without paying (subscriptions / payments)
//   - reading another user's encrypted provider keys (user_connections)
//   - self-promotion to admin (admin_users)
//   - tampering with audit logs, webhook dedupe records or feature flags
//
// If you later add a client-side real-time listener (e.g. live job progress), add a narrow
// read-only rule for that one collection, e.g.:
//
//   match /generation_jobs/{jobId} {
//     allow read: if request.auth != null && resource.data.ownerId == request.auth.uid;
//   }
//
// and keep `allow write: if false` everywhere. Test changes with the emulator:
//   firebase emulators:start --only firestore
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
