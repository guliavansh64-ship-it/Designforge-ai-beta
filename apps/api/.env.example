# ───────── DesignForge API — environment ─────────
# NEVER commit real values. Set these as host secrets (Render/Fly dashboard).
NODE_ENV=development
PORT=8080
# Comma-separated list of allowed browser origins (web app + admin)
CORS_ORIGINS=http://localhost:5173
PUBLIC_WEB_URL=http://localhost:5173

# Firebase Admin — paste the service-account JSON as a single line OR base64
FIREBASE_SERVICE_ACCOUNT_BASE64=
FIREBASE_PROJECT_ID=

# 32-byte key, base64. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Encrypts every user's Stitch / Gemini key at rest. Rotating requires re-encryption (see docs/06-SECURITY.md)
ENCRYPTION_KEY=
ENCRYPTION_KEY_ID=k1
# Rotation window only: the OLD key + its id. Old envelopes still decrypt and are re-encrypted lazily.
ENCRYPTION_KEY_PREVIOUS=
ENCRYPTION_KEY_PREVIOUS_ID=

# Razorpay (use rzp_test_ keys during development)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Optional asset CDN (otherwise assets are stored as chunked Firestore blobs — fine for small scale)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional model overrides / logging
GEMINI_IMAGE_MODEL_DEFAULT=gemini-nano-banana-2.1
GEMINI_TEXT_MODEL_DEFAULT=gemini-flash-latest
LOG_LEVEL=info

# Job queue
MAX_CONCURRENT_JOBS=4
JOB_TIMEOUT_MS=300000

# Phase-1 POC only (your OWN key, used by `npm run poc`; never used by the server)
STITCH_API_KEY=
