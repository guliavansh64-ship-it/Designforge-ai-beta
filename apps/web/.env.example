# Firebase WEB config — these identify your Firebase project and are public by design
# (security comes from Firebase Auth + Firestore rules + server checks, not from hiding these).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
# API base. Leave empty to use same-origin /api (recommended: proxy via Cloudflare Pages Functions or dev proxy).
VITE_API_BASE=
# Dev-only: proxy target for `npm run dev`
API_PROXY_TARGET=http://localhost:8080
# Dev-only UI preview with clearly-labelled sample data (never active in production builds)
VITE_UI_PREVIEW=0
