# Public config only (bundled into the app). NEVER put API secrets here.
EXPO_PUBLIC_API_URL=https://api.your-domain.com
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
# No storageBucket / messagingSenderId needed — Firebase Storage is NOT used.
# OAuth *Web* client ID from Firebase console → Authentication → Google (used to mint the ID token)
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
# Full checklist: docs/09-WHAT-I-NEED.md
